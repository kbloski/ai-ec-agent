# Katalogi robocze agenta AI: śledzimy w GitHub wyłącznie plik README.md
# opisujący przeznaczenie katalogu. Cała pozostała zawartość (w tym
# ewentualne podkatalogi) pozostaje wyłącznie lokalna.

# prompts/*
# !prompts/README.md

# memory/*
# !memory/README.md

# plans/*
# !plans/README.md

# decisions/*
# !decisions/README.md

# references/*
# !references/README.md

# templates/*
# !templates/README.md

# scratch/*
# !scratch/README.md

# output/*
# !output/README.md

# rules/*
# !rules/README.md

# project/*
# !project/README.md
